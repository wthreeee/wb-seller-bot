# Токен бота от @BotFather
BOT_TOKEN=

# Токен API продавца WB (Настройки → Доступ к API), категории «Статистика» и «Аналитика».
# Без него бот работает на демо-данных
WB_TOKEN=

# Telegram ID тех, кто пользуется ботом и получает отчёт (узнать свой: /myid)
ADMIN_IDS=

# Время ежедневного отчёта по Москве
REPORT_TIME=09:00

# Предупреждать, если остатка хватит меньше чем на столько дней
LOW_STOCK_DAYS=7

# HTTP-прокси для Telegram API, если api.telegram.org недоступен напрямую
# TELEGRAM_PROXY=http://127.0.0.1:10809
